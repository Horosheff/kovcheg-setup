{
  "log": { "loglevel": "info" },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10818,
      "protocol": "socks",
      "settings": { "udp": true }
    },
    {
      "tag": "http",
      "listen": "127.0.0.1",
      "port": 10819,
      "protocol": "http"
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "203.0.113.10",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-4000-8000-000000000001",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "reality",
        "realitySettings": {
          "serverName": "www.intel.com",
          "fingerprint": "firefox",
          "publicKey": "REPLACE_REALITY_PUB",
          "shortId": "0011223344556677"
        },
        "xhttpSettings": {
          "path": "/replacepath",
          "mode": "stream-one",
          "xPaddingBytes": "100-1000",
          "xmux": {
            "maxConcurrency": 1,
            "cMaxReuseTimes": 0,
            "hMaxRequestTimes": 1,
            "hMaxReusableSecs": 0,
            "hKeepAlivePeriod": 0
          }
        },
        "sockopt": {
          "dialerProxy": "frag",
          "tcpKeepAliveIdle": 20,
          "tcpKeepAliveInterval": 20,
          "tcpNoDelay": true
        }
      }
    },
    {
      "tag": "frag",
      "protocol": "freedom",
      "settings": {
        "fragment": {
          "packets": "tlshello",
          "length": "100-200",
          "interval": "10-20"
        }
      }
    }
  ]
}
